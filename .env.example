# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory?schema=public"

# Auth.js - generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Redis for the 60s fact cache. If unset, facts are generated on every request.
REDIS_URL="redis://localhost:6379"
